# ─────────────────────────────────────────────────────────────────────
#  settings.env – the only file you may want to edit.
#  (No inline comments after values: this file is read by bash.)
# ─────────────────────────────────────────────────────────────────────

# Team / private domain (must end in .test – never .local)
TEAM=team1
DOMAIN=team1.test

# TTL (seconds) of the project DNS records – Extension B
TTL=30

# Which stage you are in (only changes how the clients find DNS):
# 1 = clients ask node-1 directly, like a Mac's DNS setting   <- Phase 1 work, form, review
# 2 = clients list node-1 + backup node-3 via a local cache   <- Phase 2 work and final demo
# make live-p1 / make form always use 1; make live-p2 / make live always use 2.
PHASE=1

# AWS Academy Learner Lab normally allows us-east-1 (sometimes us-west-2)
REGION=us-east-1
INSTANCE_TYPE=t3.small

# Network: new = own VPC with subnet 10.0.1.0/24 (machines 10.0.1.11-14)
#          default = subnet 172.31.250.0/24 inside the account's default VPC (machines 172.31.250.11-14)
#          Use default if make fails with "VpcLimitExceeded".
VPC_MODE=default

# SSH key: leave empty and Terraform creates one for you.
# To use the Learner Lab key instead: KEY_NAME=vockey  KEY_PATH=~/.ssh/labsuser.pem
KEY_NAME=
KEY_PATH=
